---
import Button from "@/components/Button.astro"
---

<section class="relative pt-24 pb-20 md:pt-32 md:pb-28" aria-label="Hero">
	<div class="container-hero">
		<div class="mx-auto max-w-4xl text-center">
			<span class="eyebrow hero-reveal inline-flex items-center">
				<span class="pulse-dot" aria-hidden="true"></span>Pre-launch · Public testnet
			</span>

			<h1 class="type-display text-mist hero-reveal hero-reveal-delay-1 mt-6 text-balance">
				Assets built to<br />
				<span class="text-citrus">mean something.</span>
			</h1>

			<p
				class="type-body-lg text-mist-dim hero-reveal hero-reveal-delay-2 mx-auto mt-6 max-w-2xl text-balance"
			>
				NFTLox is infrastructure for creating functional digital assets that represent access,
				progress, rewards, membership, discounts, and participation across games and applications.
			</p>

			<div
				class="hero-reveal hero-reveal-delay-3 mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
			>
				<Button href="#assets" variant="primary" size="lg"> See the assets </Button>
				<Button href="https://testnet.nftlox.com/" variant="secondary" size="lg">
					Explore testnet
				</Button>
			</div>

			<div
				class="border-mist-line text-mist-dim hero-reveal hero-reveal-delay-4 type-label mx-auto mt-12 grid max-w-2xl grid-cols-1 border-y sm:grid-cols-3"
				aria-label="NFTLox principles"
			>
				<span class="border-mist-line px-4 py-3 sm:border-r">Owned by users</span>
				<span class="border-mist-line border-t px-4 py-3 sm:border-t-0 sm:border-r"
					>Built for utility</span
				>
				<span class="border-mist-line border-t px-4 py-3 sm:border-t-0">Verified on Hive</span>
			</div>
		</div>
	</div>
</section>
