---
const principles = [
	{
		index: "01",
		label: "Open integration",
		title: "Build without contracts.",
		description:
			"Create functional assets through open protocol actions. Integrate with any language that speaks HTTP; the TypeScript SDK is optional.",
	},
	{
		index: "02",
		label: "User custody",
		title: "Assets stay with their owners.",
		description:
			"Listings are on-chain state, not escrow deposits. Assets remain with their owners until a sale settles, and the indexer never receives user keys.",
	},
	{
		index: "03",
		label: "Atomic settlement",
		title: "Payment and ownership move together.",
		description:
			"Seller payment, optional creator royalty, the 1% settlement fee, and ownership transfer land—or fail—together. SPV can verify the referenced ownership edge against Hive.",
	},
] as const
---

<section
	id="philosophy"
	class="border-mist-line bg-ink-deep relative scroll-mt-24 overflow-hidden border-y pt-20 pb-12 md:pt-24 md:pb-16"
	aria-labelledby="philosophy-heading"
>
	<div class="container-content relative">
		<div class="grid gap-12 lg:grid-cols-12 lg:gap-12">
			<header class="lg:col-span-5 lg:pr-8">
				<span class="eyebrow">Design philosophy</span>
				<h2 id="philosophy-heading" class="type-title text-mist mt-4 text-balance">
					Built around ownership,<br />
					<span class="text-citrus">not contracts.</span>
				</h2>
				<p class="type-body text-mist-dim mt-7 max-w-md text-balance">
					NFTLox keeps assets with their owners, integration open to any stack, and marketplace
					settlement anchored to Hive.
				</p>
			</header>

			<ol class="border-mist-line border-t lg:col-span-7 lg:border-t-0 lg:border-l lg:pl-12">
				{
					principles.map((principle) => (
						<li class="border-mist-line grid gap-5 border-b py-7 last:border-b-0 sm:grid-cols-[3.5rem_1fr]">
							<span class="data-tag text-citrus pt-1">{principle.index}</span>
							<div>
								<span class="data-tag text-teal">{principle.label}</span>
								<h3 class="type-heading text-mist mt-3 text-balance">{principle.title}</h3>
								<p class="type-body text-mist-dim mt-3 max-w-2xl">{principle.description}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<div
			class="border-mist-line mt-10 grid justify-items-center gap-2 border-y py-5 text-center sm:flex sm:items-center sm:justify-center sm:gap-0"
			aria-label="Hive network characteristics"
		>
			<a
				class="motion-link data-tag text-citrus decoration-citrus/50 hover:decoration-citrus inline-flex items-center gap-2 underline underline-offset-4"
				href="https://hive.io/"
				target="_blank"
				rel="noreferrer"
				aria-label="Learn more about Hive"
			>
				<img src="/hextacular.svg" alt="" width="18" height="16" aria-hidden="true" />
				Hive L1
			</a>
			<span class="data-tag border-mist-line sm:ml-5 sm:border-l sm:px-5"> ~3-second blocks </span>
			<span class="data-tag border-mist-line sm:border-l sm:pl-5"> 0 fee for regular actions </span>
		</div>
	</div>
</section>
