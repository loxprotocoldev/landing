---
const assets = [
	{
		index: "01",
		category: "Game asset",
		title: "Progress that belongs to the player.",
		description:
			"Characters, items, abilities, and achievements can evolve with the experience while remaining owned by the player.",
		image: "/nft/game-asset.webp",
		alt: "Illustrated fantasy warrior shown as an example of a functional game asset",
	},
	{
		index: "02",
		category: "Fan & community",
		title: "Belonging made useful.",
		description:
			"An asset can represent membership, exclusive access, community rewards, and shared experiences.",
		image: "/nft/community-access.webp",
		alt: "Purple VIP access pass shown as an example of a fan and community asset",
	},
	{
		index: "03",
		category: "AI applications",
		title: "Benefits that respond to participation.",
		description:
			"AI-powered apps can issue discounts, loyalty status, and redeemable benefits as functional assets.",
		image: "/nft/ai-benefit.webp",
		alt: "App discount coupon shown as an example of an asset issued by an AI-powered application",
	},
	{
		index: "04",
		category: "Community-defined value",
		title: "Meaning shaped by the community.",
		description:
			"Collections can represent symbols, ideas, or digital goods. Their value can emerge from utility, provenance, scarcity, and shared recognition—not from a promise of financial backing.",
		image: "/nft/community-value.webp",
		alt: "Gold bar with a Bitcoin symbol used as an illustration of community-defined digital value",
	},
] as const
---

<section id="assets" class="relative scroll-mt-24 py-20 md:py-28" aria-labelledby="assets-heading">
	<div class="container-content">
		<header class="mb-12 grid gap-6 md:grid-cols-12 md:items-end" data-scroll-reveal>
			<div class="md:col-span-7">
				<span class="eyebrow">Assets in practice</span>
				<h2 id="assets-heading" class="type-title text-mist mt-4 text-balance">
					An asset is defined by<br />
					<span class="text-citrus">what it enables.</span>
				</h2>
			</div>
			<p class="type-body text-mist-dim max-w-xl text-balance md:col-span-5 md:justify-self-end">
				NFTLox gives applications a shared asset model. The experience defines the purpose; the
				infrastructure preserves ownership, state, and provenance.
			</p>
		</header>

		<div
			class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 md:grid md:grid-cols-2 md:overflow-visible md:pb-0 lg:grid-cols-4"
			aria-label="Functional asset examples"
		>
			{
				assets.map((asset) => (
					<article
						class="asset-card border-mist-line bg-ink-deep flex w-4/5 max-w-sm flex-none snap-start flex-col overflow-hidden border md:w-auto md:max-w-none"
						data-scroll-reveal
					>
						<div class="bg-ink relative aspect-2/3 overflow-hidden">
							<img
								src={asset.image}
								alt={asset.alt}
								width="768"
								height="1152"
								loading="eager"
								decoding="async"
								class="asset-card-image h-full w-full object-cover"
							/>
						</div>
						<div class="border-mist-line flex flex-1 flex-col border-t p-5">
							<span class="data-tag text-citrus">
								{asset.index} · {asset.category}
							</span>
							<h3 class="type-heading text-mist mt-4 text-balance">{asset.title}</h3>
							<p class="type-body text-mist-dim mt-3">{asset.description}</p>
						</div>
					</article>
				))
			}
		</div>

		<div class="border-mist-line mt-12 grid gap-8 border-t pt-8 md:grid-cols-2 md:gap-12">
			<article>
				<span class="data-tag text-teal">Social platforms</span>
				<h3 class="type-heading text-mist mt-3">Identity that can be recognized.</h3>
				<p class="type-body text-mist-dim mt-2 max-w-lg">
					Assets can express reputation, achievements, creator rewards, and community roles inside
					social experiences.
				</p>
			</article>
			<article>
				<span class="data-tag text-teal">Participation & governance</span>
				<h3 class="type-heading text-mist mt-3">A verifiable right to participate.</h3>
				<p class="type-body text-mist-dim mt-2 max-w-lg">
					Applications can use asset ownership or state to define eligibility for proposals, voting,
					and community responsibilities.
				</p>
			</article>
		</div>
	</div>
</section>
