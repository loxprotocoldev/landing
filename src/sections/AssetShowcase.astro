---
import Button from "@/components/Button.astro"

const roadmap = [
	{
		index: "01",
		category: "Fan & community",
		title: "Belonging made useful.",
		description:
			"Membership, exclusive access, community rewards, and shared experiences can live in an owned asset.",
		image: "/nft/community-access.webp",
		alt: "Purple VIP access pass shown as an example of a fan and community asset",
	},
	{
		index: "02",
		category: "AI applications",
		title: "Benefits that respond to participation.",
		description:
			"AI-powered apps can issue discounts, loyalty status, and redeemable benefits as functional assets.",
		image: "/nft/ai-benefit.webp",
		alt: "App discount coupon shown as an example of an asset issued by an AI-powered application",
	},
	{
		index: "03",
		category: "Community value",
		title: "Meaning shaped by the community.",
		description:
			"Collections can represent digital goods whose utility, provenance, scarcity, and recognition create shared meaning.",
		image: "/nft/community-value.webp",
		alt: "Gold bar with a Bitcoin symbol used as an illustration of community-defined digital value",
	},
] as const
---

<section id="assets" class="relative scroll-mt-24 py-20 md:py-28" aria-labelledby="assets-heading">
	<div class="container-content">
		<header class="mb-12 grid gap-6 md:grid-cols-12 md:items-end" data-scroll-reveal>
			<div class="md:col-span-7">
				<span class="eyebrow">Game assets · Primary use case</span>
				<h2 id="assets-heading" class="type-title text-mist mt-4 text-balance">
					Progress that belongs<br />
					<span class="text-citrus">to the player.</span>
				</h2>
			</div>
			<p class="type-body text-mist-dim max-w-xl text-balance md:col-span-5 md:justify-self-end">
				Characters, items, abilities, and achievements can evolve with the game while NFTLox
				preserves ownership, live state, and provenance underneath.
			</p>
		</header>

		<div class="grid gap-4 lg:grid-cols-12" data-scroll-reveal>
			<figure class="asset-card border-mist-line bg-ink-deep overflow-hidden border lg:col-span-5">
				<div class="bg-ink relative aspect-2/3 overflow-hidden">
					<img
						src="/nft/game-asset.webp"
						alt="Illustrated fantasy warrior shown as an example of a functional game asset"
						width="768"
						height="1152"
						loading="eager"
						decoding="async"
						class="asset-card-image h-full w-full object-cover"
					/>
				</div>
				<figcaption class="border-mist-line type-body text-mist-dim border-t p-5">
					One asset can carry player ownership, mutable progression, and a scoped use state without
					turning the game into a marketplace.
				</figcaption>
			</figure>

			<article
				class="border-mist-line bg-ink-deep flex flex-col justify-center border p-6 md:p-10 lg:col-span-7"
			>
				<div class="max-w-xl">
					<span class="data-tag text-citrus">Early use case · Pre-launch</span>
					<h3 class="type-heading text-mist mt-5 text-balance">Ragnarok NFT Game</h3>
					<p class="type-body text-mist-dim mt-4">
						Ragnarok is one of the first game use cases being explored for NFTLox: an open-source
						deck-building strategy game on Hive, where gods and titans fight in strategic 1v1 duels.
					</p>
					<div class="mt-8">
						<Button
							href="https://ragnaroknft.quest/"
							variant="secondary"
							size="lg"
							target="_blank"
							rel="noopener noreferrer"
						>
							Visit Ragnarok
						</Button>
					</div>
				</div>
			</article>
		</div>

		<div class="border-mist-line mt-16 border-t pt-8" data-scroll-reveal>
			<div class="grid gap-4 md:grid-cols-12 md:items-end">
				<div class="md:col-span-5">
					<span class="eyebrow">Roadmap · Beyond games</span>
					<h3 class="type-heading text-mist mt-4 text-balance">
						Games first. More verticals later.
					</h3>
				</div>
				<p class="type-body text-mist-dim max-w-xl md:col-span-7 md:justify-self-end">
					NFTLox starts with game assets. Future protocol applications may extend the same
					functional asset model into:
				</p>
			</div>

			<ol
				class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:overflow-visible md:pb-0"
				aria-label="Future functional asset applications"
			>
				{
					roadmap.map((item) => (
						<li class="asset-card border-mist-line bg-ink-deep flex w-4/5 max-w-sm flex-none snap-start flex-col overflow-hidden border md:w-auto md:max-w-none">
							<div class="bg-ink relative aspect-2/3 overflow-hidden">
								<img
									src={item.image}
									alt={item.alt}
									width="768"
									height="1152"
									loading="lazy"
									decoding="async"
									class="asset-card-image h-full w-full object-cover"
								/>
							</div>
							<div class="border-mist-line flex flex-1 flex-col border-t p-5">
								<span class="data-tag text-teal">
									Roadmap {item.index} · {item.category}
								</span>
								<h3 class="type-heading text-mist mt-4 text-balance">{item.title}</h3>
								<p class="type-body text-mist-dim mt-3">{item.description}</p>
							</div>
						</li>
					))
				}
			</ol>

			<div class="border-mist-line mt-8 grid gap-6 border-t pt-6 sm:grid-cols-2">
				<p class="type-body text-mist-dim">
					<span class="data-tag text-teal block">Social platforms</span>
					<span class="mt-2 block"
						>Portable achievements, creator rewards, reputation, and roles.</span
					>
				</p>
				<p class="type-body text-mist-dim">
					<span class="data-tag text-teal block">Participation & governance</span>
					<span class="mt-2 block"
						>Verifiable eligibility for proposals and community decisions.</span
					>
				</p>
			</div>
		</div>
	</div>
</section>
