---

---

<section class="relative py-20 md:py-28" aria-labelledby="composable-heading">
	<div class="container-content">
		<div class="mt-10 grid gap-12 md:grid-cols-12 md:items-start md:gap-16">
			<div class="md:col-span-4">
				<h2 id="composable-heading" class="type-title text-mist text-balance">
					One asset. More ways to participate.
				</h2>
				<p class="type-body text-mist-dim mt-6 max-w-md text-balance">
					Ownership stays anchored while mutable data and use state evolve. An instance can be
					listed or lent for scoped use; those two states are exclusive.
				</p>
			</div>

			<figure class="md:col-span-8 md:pt-2">
				<svg
					viewBox="0 0 600 320"
					width="100%"
					xmlns="http://www.w3.org/2000/svg"
					class="-mx-4 block w-[calc(100%+2rem)] max-w-none md:mx-0 md:w-full"
					aria-label="Functional asset ownership, mutable state, and exclusive listed or lent use states"
				>
					<g stroke="#f0f0f8" stroke-opacity="0.15" stroke-width="1" fill="none">
						<line x1="120" y1="60" x2="280" y2="140"></line>
						<line x1="480" y1="60" x2="320" y2="140" stroke-dasharray="4 5"></line>
						<line x1="120" y1="260" x2="280" y2="180"></line>
						<line x1="480" y1="260" x2="320" y2="180" stroke-dasharray="4 5"></line>
					</g>

					<g
						font-family="JetBrains Mono Variable, JetBrains Mono, monospace"
						font-size="11"
						font-weight="500"
						letter-spacing="0.12em"
						fill="#f0f0f8"
					>
						<g>
							<rect
								x="40"
								y="36"
								width="160"
								height="48"
								fill="#1d1f30"
								stroke="#f0f0f8"
								stroke-opacity="0.2"></rect>
							<text x="120" y="56" text-anchor="middle" fill="#20a39e">OWNED</text>
							<text
								x="120"
								y="74"
								text-anchor="middle"
								fill="#f0f0f8"
								opacity="0.65"
								font-size="11"
								letter-spacing="0.04em">player / user</text
							>
						</g>

						<text
							x="480"
							y="158"
							text-anchor="middle"
							fill="#20a39e"
							font-size="11"
							letter-spacing="0.12em">ONE USE STATE</text
						>

						<g>
							<rect
								x="400"
								y="36"
								width="160"
								height="48"
								fill="#1d1f30"
								stroke="#f0f0f8"
								stroke-opacity="0.2"></rect>
							<text x="480" y="56" text-anchor="middle" fill="#20a39e">LENT</text>
							<text
								x="480"
								y="74"
								text-anchor="middle"
								fill="#f0f0f8"
								opacity="0.65"
								font-size="11"
								letter-spacing="0.04em">scoped use</text
							>
						</g>

						<g>
							<rect
								x="400"
								y="236"
								width="160"
								height="48"
								fill="#1d1f30"
								stroke="#f0f0f8"
								stroke-opacity="0.2"></rect>
							<text x="480" y="256" text-anchor="middle" fill="#20a39e">LISTED</text>
							<text
								x="480"
								y="274"
								text-anchor="middle"
								fill="#f0f0f8"
								opacity="0.65"
								font-size="11"
								letter-spacing="0.04em">marketplace</text
							>
						</g>

						<g>
							<rect
								x="40"
								y="236"
								width="160"
								height="48"
								fill="#1d1f30"
								stroke="#f0f0f8"
								stroke-opacity="0.2"></rect>
							<text x="120" y="256" text-anchor="middle" fill="#20a39e">STATE</text>
							<text
								x="120"
								y="274"
								text-anchor="middle"
								fill="#f0f0f8"
								opacity="0.65"
								font-size="11"
								letter-spacing="0.04em">xp · level · wins</text
							>
						</g>
					</g>

					<g>
						<rect x="220" y="116" width="160" height="88" fill="#e2eb98" stroke="#cfd988"></rect>
						<text
							x="300"
							y="148"
							font-family="Space Grotesk Variable, Space Grotesk, sans-serif"
							font-size="11"
							font-weight="600"
							fill="#282a3e"
							text-anchor="middle"
						>
							Functional asset
						</text>
						<text
							x="300"
							y="168"
							font-family="JetBrains Mono Variable, JetBrains Mono, monospace"
							font-size="11"
							font-weight="500"
							fill="#282a3e"
							opacity="0.7"
							text-anchor="middle"
						>
							owned + mutable state
						</text>
						<text
							x="300"
							y="186"
							font-family="JetBrains Mono Variable, JetBrains Mono, monospace"
							font-size="11"
							font-weight="500"
							fill="#282a3e"
							text-anchor="middle"
						>
							protocol instance
						</text>
					</g>
				</svg>
			</figure>
		</div>
	</div>
</section>
