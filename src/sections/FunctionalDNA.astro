<section
	id="purpose"
	class="relative scroll-mt-24 py-20 md:py-28"
	aria-labelledby="purpose-heading"
>
	<div class="container-content">
		<header class="mb-12 grid gap-6 md:grid-cols-12 md:items-end md:gap-12">
			<div class="md:col-span-7">
				<span class="eyebrow">Functional DNA</span>
				<h2 id="purpose-heading" class="type-title text-mist mt-4 text-balance">
					Built for assets<br />
					<span class="text-citrus">with purpose.</span>
				</h2>
			</div>
			<p class="type-body text-mist-dim max-w-xl text-balance md:col-span-5 md:justify-self-end">
				The infrastructure should disappear into the experience. People see what an asset lets them
				do; NFTLox preserves the meaning and state underneath.
			</p>
		</header>

		<ol class="grid gap-4">
			<li
				class="border-mist-line bg-ink-deep grid overflow-hidden border lg:min-h-96 lg:grid-cols-12"
			>
				<div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-5 lg:p-10">
					<span class="data-tag text-citrus">01 · Meaning</span>
					<div class="mt-16 lg:mt-24">
						<h3 class="type-heading text-mist">Give it meaning.</h3>
						<p class="type-body text-mist-dim mt-4 max-w-md">
							A collection defines what an asset represents: a character, membership, reward, pass,
							or community role.
						</p>
					</div>
				</div>

				<div
					class="border-mist-line bg-ink relative flex min-h-80 items-center overflow-hidden border-t p-6 sm:p-10 lg:col-span-7 lg:min-h-full lg:border-t-0 lg:border-l lg:p-12"
					aria-hidden="true"
				>
					<div class="border-mist-line w-full border-y">
						<div class="border-mist-line flex items-center justify-between gap-5 border-b py-4">
							<span class="data-tag text-mist-dim">Collection</span>
							<span class="data-tag text-teal">Defines meaning</span>
						</div>
						<div class="grid sm:grid-cols-3">
							<div class="border-mist-line border-t py-4 sm:pr-5">
								<span class="type-ui text-mist">Character</span>
							</div>
							<div class="border-mist-line border-t py-4 sm:border-l sm:pr-5 sm:pl-5">
								<span class="type-ui text-citrus">Membership</span>
							</div>
							<div class="border-mist-line border-t py-4 sm:border-l sm:pl-5">
								<span class="type-ui text-mist">Reward</span>
							</div>
							<div class="border-mist-line border-t py-4 sm:pr-5">
								<span class="type-ui text-mist-dim">Pass</span>
							</div>
							<div class="border-mist-line border-t py-4 sm:col-span-2 sm:border-l sm:pl-5">
								<span class="type-ui text-mist-dim">Community role</span>
							</div>
						</div>
					</div>
				</div>
			</li>

			<li
				class="border-mist-line bg-ink-deep grid overflow-hidden border lg:min-h-96 lg:grid-cols-12"
			>
				<div
					class="border-mist-line bg-ink order-2 flex min-h-80 items-center overflow-hidden border-t p-6 sm:p-10 lg:order-1 lg:col-span-7 lg:min-h-full lg:border-t-0 lg:border-r lg:p-12"
					aria-hidden="true"
				>
					<div class="w-full">
						<div class="flex items-center justify-between gap-5">
							<span class="data-tag text-mist-dim">Mutable data</span>
							<span class="data-tag text-teal">Current state</span>
						</div>
						<div class="border-mist-line mt-8 border-y py-6">
							<div class="grid gap-5 sm:grid-cols-3 sm:gap-0">
								<div class="sm:pr-5">
									<span class="data-tag text-citrus">Progress</span>
									<div class="border-mist-line mt-4 border-t"></div>
								</div>
								<div class="sm:border-mist-line sm:border-l sm:pr-5 sm:pl-5">
									<span class="data-tag text-mist">Participation</span>
									<div class="border-mist-line mt-4 border-t"></div>
								</div>
								<div class="sm:border-mist-line sm:border-l sm:pl-5">
									<span class="data-tag text-mist-dim">Loyalty</span>
									<div class="border-mist-line mt-4 border-t"></div>
								</div>
							</div>
							<div class="mt-10 flex items-center gap-4">
								<span class="data-tag text-mist-dim">Initial</span>
								<span class="border-mist-line h-px flex-1 border-t"></span>
								<span class="bg-teal h-2 w-2"></span>
								<span class="data-tag text-teal">Evolves</span>
							</div>
						</div>
					</div>
				</div>

				<div
					class="order-1 flex flex-col justify-between p-6 sm:p-8 lg:order-2 lg:col-span-5 lg:p-10"
				>
					<span class="data-tag text-citrus">02 · State</span>
					<div class="mt-16 lg:mt-24">
						<h3 class="type-heading text-mist">Let it evolve.</h3>
						<p class="type-body text-mist-dim mt-4 max-w-md">
							Mutable data can carry progress, participation, loyalty, or other application-defined
							state.
						</p>
					</div>
				</div>
			</li>
		</ol>
	</div>
</section>
