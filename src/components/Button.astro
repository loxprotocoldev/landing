---
import type { HTMLAttributes } from "astro/types"

type Variant = "primary" | "secondary" | "ghost" | "mono"
type Size = "sm" | "md" | "lg"

interface Props extends HTMLAttributes<"a"> {
	href?: string
	variant?: Variant
	size?: Size
	as?: "a" | "button"
	type?: "button" | "submit" | "reset"
}

const {
	href,
	variant = "primary",
	size = "md",
	as = href ? "a" : "button",
	type = "button",
	class: className,
	...rest
} = Astro.props

const base =
	"button-control motion-control inline-flex items-center justify-center font-medium tracking-tight focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-ink focus:ring-citrus disabled:opacity-50 disabled:cursor-not-allowed"

const variants: Record<Variant, string> = {
	primary: "button-control-primary bg-citrus text-ink hover:bg-citrus-soft",
	secondary:
		"button-control-secondary border border-mist-faint text-mist hover:border-mist/40 hover:bg-mist-faint/50",
	ghost: "text-mist-dim hover:text-mist",
	mono: "button-control-mono type-label border border-mist-faint text-mist hover:border-citrus hover:text-citrus",
}

const sizes: Record<Size, string> = {
	sm: "px-3.5 py-2 text-sm",
	md: "px-5 py-2.5 text-sm",
	lg: "px-6 py-3 text-base",
}

const classes = [base, variants[variant], sizes[size], className].filter(Boolean).join(" ")
---

{
	as === "a" ? (
		<a href={href} class={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type={type} class={classes} {...rest}>
			<slot />
		</button>
	)
}
