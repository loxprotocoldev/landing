---
interface Props {
	eyebrow?: string
	title: string
	description?: string
	align?: "left" | "center"
	class?: string
}

const { eyebrow, title, description, align = "center", class: className } = Astro.props

const alignment = align === "center" ? "items-center text-center" : "items-start text-left"
---

<header class:list={["flex max-w-2xl flex-col gap-3", alignment, className]}>
	{eyebrow && <span class="eyebrow">{eyebrow}</span>}
	<h2 class="type-title text-mist text-balance">{title}</h2>
	{description && <p class="type-body-lg text-mist-dim text-balance">{description}</p>}
</header>
